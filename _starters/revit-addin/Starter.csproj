<Project Sdk="Microsoft.NET.Sdk">
  <!-- Rename this file to rename the add-in: the DLL and install.ps1 follow it. -->
  <PropertyGroup>
    <!-- Build for the client's version: dotnet build -c Release -p:RevitVersion=2025 -->
    <RevitVersion Condition="'$(RevitVersion)' == ''">2024</RevitVersion>
    <!-- Revit 2027 runs on .NET 10, 2025 and 2026 on .NET 8, 2024 and earlier on .NET Framework 4.8. -->
    <TargetFramework Condition="$(RevitVersion) &gt;= 2027">net10.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) == 2025 Or $(RevitVersion) == 2026">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>9.0</LangVersion>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile-only copies of the Revit API, so this builds without Revit installed. Never shipped. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
